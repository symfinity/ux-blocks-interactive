{% import '@UxBlocksCore/components/_component_style.html.twig' as componentStyle %}
<div
    data-ui-role="masonry"
    data-ui-fragment="blocks.int.masonry"
    data-controller="symfinity--ux-blocks-interactive--masonry"
    data-ui-density="{{ density }}"
    style="{{ componentStyle.rootStyle(attributes, '--ui-density: ' ~ density ~ ';') }}"
    {% if columns %}data-ui-columns="{{ columns }}"{% endif %}
    {{ attributes.without('style') }}
>
    <div data-ui-part="masonry-layout" data-symfinity--ux-blocks-interactive--masonry-target="layout">
        {% block content %}{% endblock %}
    </div>
</div>
