<twig:Button
    variant="{{ variant ?? 'danger' }}"
    appearance="{{ appearance ?? 'solid' }}"
    size="{{ size ?? 'md' }}"
    {{ ...attributes.without('data-ui-role').defaults({
        type: 'button',
        'data-action': 'click->symfinity--ux-blocks-interactive--alert-dialog#confirm',
    }) }}
>
    {{- block(outerBlocks.content) -}}
</twig:Button>
