<twig:Button
    variant="{{ variant ?? 'primary' }}"
    appearance="{{ appearance ?? 'solid' }}"
    size="{{ size ?? 'md' }}"
    {{ ...attributes.without('data-ui-role').defaults({
        type: 'button',
        'aria-haspopup': 'dialog',
        'aria-expanded': 'false',
        'data-action': 'click->symfinity--ux-blocks-interactive--alert-dialog#open',
        'data-symfinity--ux-blocks-interactive--alert-dialog-target': 'trigger',
    }) }}
>
    {{- block(outerBlocks.content) -}}
</twig:Button>
