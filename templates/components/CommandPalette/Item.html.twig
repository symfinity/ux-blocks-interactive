{% if href %}
<a
    href="{{ href }}"
    data-ui-role="command-palette-item"
    data-symfinity--ux-blocks-interactive--command-palette-target="item"
    data-action="click->symfinity--ux-blocks-interactive--command-palette#visit"
    {{ attributes }}
>
{% else %}
<button
    type="button"
    data-ui-role="command-palette-item"
    data-symfinity--ux-blocks-interactive--command-palette-target="item"
    data-action="click->symfinity--ux-blocks-interactive--command-palette#visit"
    {{ attributes }}
>
{% endif %}
    <span data-ui-part="menu-item-body">
        {% include '@UxBlocksInteractive/components/_shared/p_menu_item_icon.html.twig' with {
            iconName: resolved_menu_item_icon,
            iconDecorative: iconDecorative,
        } only %}
        <span data-ui-part="content">{% block content %}{% endblock %}</span>
        {% if hint %}
            <span data-ui-part="hint">{{ hint }}</span>
        {% endif %}
    </span>
{% if href %}
</a>
{% else %}
</button>
{% endif %}
